# PostgreSQL（async SQLAlchemy）
DATABASE_URL=postgresql+asyncpg://run_coach:run_coach@localhost:5433/run_coach

# JWT HS256
JWT_SECRET=change-me-in-development

# OpenAI-compatible LLM（仅真实 LLMReasoner 需要；场景测试使用 ScriptedReasoner）
# 自行填写供应商的 key、兼容端点和模型名，不要把供应商地址写进仓库默认值。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# AgentRuntime 基础设施护栏，不是产品契约
AGENT_MAX_STEPS=16
CONVERSATION_HISTORY_LIMIT=20
