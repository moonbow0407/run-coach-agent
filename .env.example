# PostgreSQL（async SQLAlchemy）。使用本地安装的 PostgreSQL 实例，需已安装 pgvector 扩展
DATABASE_URL=postgresql+asyncpg://postgres:114514@localhost:5432/run_coach

# JWT HS256
# 必须填写至少 32 个字符的随机值；应用不会使用公开默认密钥启动。
JWT_SECRET=

# OpenAI-compatible LLM（仅真实 LLMReasoner 需要；场景测试使用 ScriptedReasoner）
# 自行填写供应商的 key、兼容端点和模型名，不要把供应商地址写进仓库默认值。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# AgentRuntime 基础设施护栏，不是产品契约
AGENT_MAX_STEPS=16
CONVERSATION_HISTORY_LIMIT=20
